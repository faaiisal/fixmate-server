# FixMate Backend — Environment Variables Template
# Copy to .env and fill real values. Never commit .env.

# Server
PORT=8000
NODE_ENV=development

# MongoDB (use same Atlas URI as frontend BETTER_AUTH_DB_URL)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
DB_NAME=fixmatedb

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# BetterAuth — must match frontend secret for session verification
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd

# ImgBB
IMGBB_API_KEY=your_imgbb_api_key

# Optional
NEXT_PUBLIC_API_URL=http://localhost:8000/api
