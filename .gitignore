# Dependencies & Package Managers - NEVER push node_modules (85+ MB)
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production Build Output - NEVER push compiled JS (regenerated via npm run build)
build/
dist/
.next/
out/
.turbo/
coverage/
.nyc_output/
storybook-static/

# Environment Variables - MUST NOT push secrets (DB URIs, API keys, secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Allow example file with placeholders only - must be tracked
!.env.example

# Logs - Never push logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & System Files - Never push OS junk
.DS_Store
.DS_Store?
*.pem
Thumbs.db
ehthumbs.db
Icon?

# Deployment
.vercel/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Editor Settings - Don't push personal editor configs (keep extensions.json)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Local-only Design Resources - DO NOT PUSH (private notes, local exports)
fixmate-local/
.stitch/
.local-design/

# Optional: Local database dumps, large files - DO NOT PUSH
*.dump
*.sql
*.sqlite
*.db
